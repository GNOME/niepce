{
    "app-id": "net.figuiere.Niepce",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.llvm22",
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "niepce",
    "finish-args" : [
        "--allow=devel",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=host",
        "--share=network",
        "--talk-name=org.gtk.vfs.*",
        "--filesystem=xdg-run/gvfsd",
        "--device=all"
    ],
    "build-options" : {
        "build-args": [
            "--share=network"
        ],
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/devhelp",
        "/share/doc",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libgphoto2",
            "cleanup": [
                "/bin",
                "/share/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/gphoto/libgphoto2/releases/download/v2.5.34/libgphoto2-2.5.34.tar.bz2",
                    "sha256": "5df9e774eb4ab6087a193afff84dcafe9f666e3443fe29e73e6779f659ff7f28"
                }
            ]
        },
        {
            "name": "libraw",
            "config-opts": [
                "--disable-static"
            ],
            "cleanup": [
                "/bin",
                "/share/doc"
            ],
            "sources": [
                {
                    "type" : "archive",
                    "url": "http://www.libraw.org/data/LibRaw-0.22.3.tar.gz",
                    "sha256": "789f3c33466210a1a0907f747a97c715d21bbf4af712f257fcbbd90111b227e4"
                }
            ]
        },
        {
            "name": "exiv2",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DEXIV2_BUILD_DOC=OFF",
                "-DEXIV2_BUILD_SAMPLES=OFF",
                "-DEXIV2_BUILD_EXIV2_COMMAND=OFF",
                "-DEXIV2_ENABLE_BMFF=ON",
                "-DEXIV2_ENABLE_INIH=OFF"
            ],
            "cleanup": [
                "/bin",
                "/lib/cmake",
                "/share/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Exiv2/exiv2/archive/refs/tags/v0.28.9.tar.gz",
                    "sha256": "700b76b97695b2fab4ef8c79619c68ae57d09e0c130724791cafbd39e0eb4aef"
                }
            ]
        },
        {
            "name" : "babl",
            "buildsystem": "meson",
            "cleanup": [
                "/bin"
            ],
            "config-opts": [
                "-Dwith-docs=false",
                "-Denable-vapi=false",
                "-Denable-gir=false"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url": "https://download.gimp.org/pub/babl/0.1/babl-0.1.128.tar.xz",
                    "sha256": "e676507b421d414d49db8627415dc1eadbd787536baa7d6fe94a1f1971cbe73e"
                }
            ]
        },
        {
            "name": "lensfun",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "build-options": {
                "arch": {
                    "x86_64": {
                        "config-opts": [
                            "-DBUILD_FOR_SSE=1",
                            "-DBUILD_FOR_SSE2=1"
                        ]
                    }
                }
            },
            "cleanup": [
                "/lib/python3.*",
                "/bin"
            ],
            "post-install": [
                "python3 lensfun_convert_db.py $PWD lensfun-git/data/db",
                "rm -rf /app/share/lensfun/version_1/*",
                "tar xvf db/version_1.tar -C /app/share/lensfun/version_1"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/lensfun/lensfun/archive/refs/tags/v0.3.3.tar.gz",
                    "sha256": "57ba5a0377f24948972339e18be946af12eda22b7c707eb0ddd26586370f6765"
                },
                {
                    "type": "file",
                    "path": "lensfun_convert_db.py"
                },
                {
                    "type": "git",
                    "dest": "lensfun-git",
                    "url": "https://github.com/lensfun/lensfun.git",
                    "commit": "413bf8f261825f3e3062c17868e7766f2ebe8a21"
                }
            ]
        },
        {
            "name": "gegl",
            "buildsystem": "meson",
            "cleanup": [
                "/bin"
            ],
            "config-opts": [
                "-Dgtk-doc=false",
                "-Dvapigen=disabled",
                "-Dlibav=disabled",
                "-Dintrospection=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gimp.org/pub/gegl/0.4/gegl-0.4.72.tar.xz",
                    "sha256": "ccbb8cdd1db56ecd4ece5dbabae0118ab2c46b5b3439c94f3cec467798ce956d"
                }
            ]
        },
        {
            "name": "mm-common",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/mm-common/0.9/mm-common-0.9.12.tar.xz",
                    "sha256": "ceffdcce1e5b52742884c233ec604bf6fded12eea9da077ce7a62c02c87e7c0b"
                }
            ]
        },
        {
            "name": "sigc++",
            "cleanup": [
                "/lib/sigc++-*"
            ],
            "config-opts": [
                "--disable-documentation"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libsigc++/3.2/libsigc++-3.2.0.tar.xz",
                    "sha256": "8cdcb986e3f0a7c5b4474aa3c833d676e62469509f4899110ddf118f04082651"
                }
            ]
        },
        {
            "name": "glibmm",
            "buildsystem": "meson",
            "cleanup": [
                "/lib/giomm-*",
                "/lib/glibmm-*"
            ],
            "config-opts": [
                "-Dbuild-deprecated-api=false",
                "-Dbuild-examples=false",
                "-Dbuild-documentation=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/glibmm.git",
                    "tag": "2.88.1",
                    "commit": "e55cb434920942d4f70ada12c6287fccbdb931c9"
                },
                {
                    "type": "patch",
                    "paths": [
                        "patches/0001-Gio-Emblem-and-DBus-ActionGroup-Don-t-derive-gtkmm__.patch",
                        "patches/0002-Gio-DBus-ActionGroup-Improve-the-test-whether-GDBusA.patch"
                    ]
                }
            ]
        },
        {
            "name": "cairomm",
            "cleanup": [
                "/lib/cairomm-1.16"
            ],
            "config-opts": [
                "--disable-documentation"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "http://cairographics.org/releases/cairomm-1.16.1.tar.xz",
                    "sha256": "6f6060d8e98dd4b8acfee2295fddbdd38cf487c07c26aad8d1a83bb9bff4a2c6"
                }
            ]
        },
        {
            "name": "libshumate",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgtk_doc=false",
                "-Dvapi=false",
                "-Dgir=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/libshumate.git",
                    "tag": "1.0.5",
                    "commit": "05bf8b37a274cb72e61b4d59bb8e804b88d8b046"
                }
            ]
        },
        {
            "name": "exempi",
            "config-opts": [
                "--enable-unittest=no"
            ],
            "cleanup": [
                "/bin",
                "/share/man"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://libopenraw.freedesktop.org/download/exempi-2.6.6.tar.xz",
                    "sha256": "900fb9957be2095c78e5111b99c49378adac58161a358f52f93c55126f34eb8f"
                }
            ]
        },
        {
            "name": "libiptcdata",
            "config-opts": [
                "--disable-static",
                "--disable-gtk-doc",
                "--enable-maintainer-mode"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ianw/libiptcdata/archive/release_1_0_5.tar.gz",
                    "sha256": "78a5c49b646cb610c84bc4dfc730caad9a06e9b4e295600908782f4abb25316e"
                },
                {
                    "type": "shell",
                    "commands": [
                        "cp -p /usr/share/automake-*/config.{sub,guess} ."
                    ]
                }
            ]
        },
        "fftw3f.json",
        {
            "name": "niepce",
	    "buildsystem": "meson",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/niepce/cargo"
                }
            },
            "config-opts": [
                "-Dprofile=release"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
